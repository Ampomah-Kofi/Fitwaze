# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.

# --- Database ---
# Production/dev: PostgreSQL + PostGIS (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://fitwaze:fitwaze@localhost:5432/fitwaze

# Test suite uses SQLite by default (see backend/tests/conftest.py); override if you
# want to run tests against a real Postgres+PostGIS instance instead.
TEST_DATABASE_URL=sqlite:///./test.db

# --- Auth / JWT ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level encryption (AES-256-GCM) ---
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# --- Route Engine ---
# "mock" (default, no network calls) or "ors" (real OpenRouteService calls)
ROUTE_PROVIDER=mock
# Only required if ROUTE_PROVIDER=ors. Get a free key at https://openrouteservice.org/
ORS_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
