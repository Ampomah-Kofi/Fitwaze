# Copy this file to `backend/.env` and fill in real values.
# NEVER commit the real `.env` file — it is gitignored for a reason.
#
#   cp .env.example backend/.env
#
# docker-compose.yml reads the same file, so one copy serves both the
# containerised stack and a local `uvicorn` run.

# --- Database ---
# Local dev / production: PostgreSQL + PostGIS (see docker-compose.yml).
# Under Docker Compose this value is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg2://fitwaze:fitwaze@localhost:5432/fitwaze

# The test suite uses SQLite by default (see backend/tests/conftest.py);
# override only if you want to run tests against real Postgres+PostGIS.
TEST_DATABASE_URL=sqlite:///./test.db

# --- Auth / JWT ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level encryption (AES-256-GCM) ---
# Required — the app cannot decrypt stored health fields without it.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# --- Route engine / map data ---
# "osrm" = real walking/cycling routes along streets and paths, no API key.
#          Default endpoints are the free FOSSGIS servers (light use only).
#          For Alabama, self-host instead: run scripts/prepare-alabama-map.sh
#          (or .ps1), `docker compose --profile alabama up -d`, and point the
#          two URLs below at localhost:5001 / :5002.
# "ors"  = OpenRouteService: street routes plus measured hills, steps, busy
#          roads and greenery. Free API key at
#          https://openrouteservice.org/dev/#/signup (~2,000 requests/day).
# "mock" = synthetic straight-line shapes, no network. Tests and offline only.
ROUTE_PROVIDER=osrm
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike/route/v1/bike
ORS_API_KEY=

# Candidate routes are cached per (start point, activity, duration) for this
# many seconds. One /route/options call costs three provider requests, so this
# reduces repeat provider calls. Clients should echo candidate_revision on
# /route/select to detect changed candidates after expiry or a worker restart.
# Set to 0 to disable caching entirely.
ROUTE_CACHE_TTL_SECONDS=900

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
